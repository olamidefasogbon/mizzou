MODEL_API_KEY=your_model_api_key_here
# Legacy fallback also accepted by packages/core/src/meta/client.ts
# META_API_KEY=your_meta_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server only. Never prefix with NEXT_PUBLIC_; never import into client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Google OAuth is configured inside Supabase; no Google vars belong here or in app code.
# Budgets (section 9.3). Spec defaults are 1.00 / 15; dev pins to 5 / 25.
PER_USER_DAILY_USD=5
GLOBAL_DAILY_USD=25
# Abuse caps (no-signup; enforced server-side, counts in Supabase rate_counters).
MAX_MESSAGE_CHARS=4000
MAX_RUNS_PER_IP_PER_DAY=50
MAX_HITS_PER_IP_PER_MINUTE=20
MAX_PAGES_PER_RUN=25
MAX_UPLOAD_BYTES=8388608
# Optional salt for IP hashing (raw IPs are never stored). Empty is fine.
# IP_HASH_SALT=
