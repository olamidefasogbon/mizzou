{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    // eval runs directly from source via node type-stripping (see "eval"
    // script), so relative imports use explicit .ts extensions here.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"]
}
